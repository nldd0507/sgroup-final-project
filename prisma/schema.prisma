generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model schema_migrations {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model assignments {
  id          Int           @id @default(autoincrement())
  class_id    Int
  title       String        @db.VarChar(200)
  description String?
  deadline    DateTime      @db.Timestamptz(6)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)
  classes     classes       @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submissions submissions[]

  @@index([class_id], map: "idx_assignments_class_id")
}

model class_members {
  id        Int      @id @default(autoincrement())
  class_id  Int
  member_id Int
  joined_at DateTime @default(now()) @db.Timestamptz(6)
  classes   classes  @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([class_id, member_id], map: "uq_class_member")
  @@index([member_id], map: "idx_class_members_member_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model classes {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(150)
  description   String?
  start_date    DateTime        @db.Date
  end_date      DateTime        @db.Date
  mentor_id     Int
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  assignments   assignments[]
  class_members class_members[]
  users         users           @relation(fields: [mentor_id], references: [id], onUpdate: NoAction)
  lessons       lessons[]

  @@index([mentor_id], map: "idx_classes_mentor_id")
}

model lesson_progress {
  id           Int      @id @default(autoincrement())
  lesson_id    Int
  member_id    Int
  completed_at DateTime @default(now()) @db.Timestamptz(6)
  lessons      lessons  @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lesson_id, member_id], map: "uq_lesson_member")
  @@index([member_id], map: "idx_lesson_progress_member_id")
}

model lessons {
  id              Int               @id @default(autoincrement())
  class_id        Int
  title           String            @db.VarChar(200)
  content         String
  order_no        Int
  created_by      Int
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  lesson_progress lesson_progress[]
  classes         classes           @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users             @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@unique([class_id, order_no], map: "uq_lesson_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model submissions {
  id             Int         @id @default(autoincrement())
  assignment_id  Int
  member_id      Int
  content        String?
  repository_url String?     @db.VarChar(500)
  submitted_at   DateTime    @default(now()) @db.Timestamptz(6)
  feedback       String?
  reviewed_at    DateTime?   @db.Timestamptz(6)
  assignments    assignments @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users       @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignment_id, member_id], map: "uq_submission")
  @@index([member_id], map: "idx_submissions_member_id")
}

model users {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  email           String            @unique @db.VarChar(255)
  password_hash   String            @db.VarChar(255)
  role            user_role         @default(MEMBER)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  refresh_token   String?
  class_members   class_members[]
  classes         classes[]
  lesson_progress lesson_progress[]
  lessons         lessons[]
  submissions     submissions[]
}

enum user_role {
  ADMIN
  MEMBER
}
